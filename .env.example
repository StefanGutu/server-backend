DATABASE_URL=postgres://echopass:echopass@localhost:5433/echopass
PORT=3000
TEST_MODE=true
# signs the access tokens; at least 32 characters. Make your own: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# pushes: true sends them through Expo, false only writes them in the log (default: true, but false in TEST_MODE)
# EXPO_PUSH=false
# EXPO_ACCESS_TOKEN=
# the secret of the display calls (buses, positions, photos...): `Authorization: Bearer <this>`. Empty = those calls are off
# DISPLAY_TOKEN=
# login calls (/auth/anonymous, /auth/refresh, /auth/link, /auth/signin) one IP address may make in the window; 0 = no limit
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_SECS=60
